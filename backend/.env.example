
# VibeSphere backend environment variables
# These are examples only. Set real values in your terminal or hosting dashboard.

# PostgreSQL database
DB_URL=jdbc:postgresql://localhost:5432/vibesphere_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password

# Required: use a unique, randomly generated secret of at least 32 bytes
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional JWT expiration (24 hours)
JWT_EXPIRATION_MS=86400000

# Allowed frontend origins for local development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true when deployed over HTTPS
COOKIE_SECURE=false

# Optional directory for uploaded files
UPLOAD_DIR=./uploads
